# ============================================================================
# Attendance-Tool environment variables
# ============================================================================
# Copy to .env (or .env.local) and fill in real values. NEVER commit real
# secrets — this file only ships placeholders.
#
# Variable classes:
#   [PUBLIC]  Inlined into the browser bundle by Next.js. Not secret.
#   [SERVER]  Server-only. Never referenced from client components.
#   [TEST]    Only read when NODE_ENV != production (e2e time control).
#   [REQUIRED]In production the server FAILS FAST (500) if these are missing.
#
# PRODUCTION checklist is in docs/DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# [PUBLIC] [REQUIRED] Supabase connection
# ---------------------------------------------------------------------------
# Local: `supabase status` → Publishable key
# Remote: Project Settings → API (anon) key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# [SERVER] [REQUIRED] Supabase service role
# ---------------------------------------------------------------------------
# NEVER expose to the browser. Bypasses RLS — server code only.
# Local: `supabase status` → Secret key | Remote: service_role secret.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# [SERVER] [REQUIRED in prod] Site origin / CRON secret
# ---------------------------------------------------------------------------
# Public origin of the deployed app (no trailing slash), e.g.
#   SITE_URL=https://attendance.your-church.org
# Used in deployment docs/auth redirect configuration.
SITE_URL=

# Secret token protecting GET /api/cron/birthdays. Sent as a Bearer header:
#   curl -H "Authorization: Bearer <CRON_SECRET>" \
#     https://<host>/api/cron/birthdays
# Generate one: `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# SMS / WhatsApp — Twilio (optional)
# ---------------------------------------------------------------------------
# All three must be set for SMS delivery to work. If any is missing, SMS
# delivery returns PROVIDER_NOT_CONFIGURED and in-app notifications still
# succeed normally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1234567890           # Your Twilio phone number (E.164)

# WhatsApp sender — must be a Twilio WhatsApp-enabled number.
# Format: "whatsapp:+14155238886"
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# [TEST] e2e time control — ignored in production (NODE_ENV gate)
# ---------------------------------------------------------------------------
# Fixed "now" for deterministic attendance/score e2e runs against the local
# stack. Production always uses the real server clock.
# ATTENDANCE_TEST_NOW=2026-09-01T12:00:00.000Z