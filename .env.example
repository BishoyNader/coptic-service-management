# Supabase — local: `supabase status` → Publishable key
#          remote: Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. NEVER expose to the browser.
# Local: `supabase status` → Secret key | Remote: service_role secret.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# SMS / WhatsApp — Twilio (optional)
# ---------------------------------------------------------------------------
# All three must be set for SMS delivery to work. If any is missing, SMS
# delivery returns PROVIDER_NOT_CONFIGURED and in-app notifications still
# succeed normally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1234567890           # Your Twilio phone number (E.164)

# WhatsApp sender — must be a Twilio WhatsApp-enabled number.
# Format: "whatsapp:+14155238886"
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Cron / Scheduler — Birthday automation
# ---------------------------------------------------------------------------
# Secret token to protect the /api/cron/birthdays endpoint.
# In production, set this and configure your cron scheduler to call:
#   GET /api/cron/birthdays?secret=<CRON_SECRET>
# For local development, call manually:
#   curl "http://localhost:3000/api/cron/birthdays?secret=YOUR_SECRET"
CRON_SECRET=
